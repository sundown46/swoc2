# SWOC2 configuration. Copy to .env and fill in. All settings come from environment variables
# (CLAUDE.md principle #8, ARCHITECTURE §12). Every variable used by the app must be documented
# here, even if left empty for local dev.

# --- HTTP / networking (GEN-004, GEN-005) ---
SWOC2_HTTP_PORT=5080
SWOC2_BASE_PATH=/
SWOC2_PUBLIC_URL=http://localhost:5080
SWOC2_FORWARDED_HEADERS=true
SWOC2_COOKIE_SECURE=auto

# --- Database (PostgreSQL + PostGIS + TimescaleDB) ---
SWOC2_DB_URL=jdbc:postgresql://localhost:5432/swoc2
SWOC2_DB_USER=swoc2
SWOC2_DB_PASSWORD=

# --- Auth: Keycloak via OIDC, backend-for-frontend (AUTH-001, ARCHITECTURE §7) ---
SWOC2_OIDC_ISSUER_URI=
SWOC2_OIDC_BACKCHANNEL_URI=
SWOC2_OIDC_CLIENT_ID=swoc2
SWOC2_OIDC_CLIENT_SECRET=

# Service account for invite-based registration (AUTH-003). Optional: leave empty and set
# SWOC2_REGISTRATION_MODE=existing-users-only if this instance has none.
SWOC2_KC_ADMIN_CLIENT_ID=
SWOC2_KC_ADMIN_SECRET=
SWOC2_REGISTRATION_MODE=invite

# --- Storage & secrets ---
SWOC2_DATA_DIR=./data
SWOC2_SECRET_KEY=

# --- Operations ---
SWOC2_LOG_LEVEL=INFO
SWOC2_PROFILE=dev

# --- Plugins (ARCHITECTURE §8.2); comma-separated plugin ids ---
SWOC2_PLUGINS_ENABLED=
SWOC2_PLUGINS_DISABLED=
SWOC2_PLUGINS_CALL_TIMEOUT=5s
SWOC2_PLUGINS_MAX_FAILURES=3

# --- Optional built-in TLS (GEN-013) ---
SWOC2_TLS_MODE=off
SWOC2_TLS_CERT_FILE=
SWOC2_TLS_KEY_FILE=

# --- Internet-facing hardening (GEN-014/GEN-015) ---
SWOC2_ADMIN_ALLOWED_CIDRS=
SWOC2_SESSION_TIMEOUT=PT12H
